# ========================================================
# Environment Variables Configuration
# ========================================================

# Database (PostgreSQL for Docker, SQLite default for local zero-config run)
# Local SQLite default:
DATABASE_URL=sqlite:///./gaming_activity.db

# Docker PostgreSQL:
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/gaming_db

# Application Configuration
APP_NAME="Gaming & Activity Dashboard API"
APP_VERSION="1.0.0"
DEBUG=True
MAX_UPLOAD_SIZE_MB=15

# Frontend Port
PORT=5173
